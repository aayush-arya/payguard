# Copy to terraform.tfvars (gitignored, same pattern as .env) and fill in
# real values before running `terraform plan`/`apply`. api_image and
# worker_image have no default in variables.tf specifically so this file
# can't be silently skipped -- terraform will refuse to plan without them.

aws_region   = "us-east-1"
environment  = "production"

api_image    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/payguard-api:latest"
worker_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/payguard-worker:latest"
