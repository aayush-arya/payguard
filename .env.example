DATABASE_URL=postgresql+asyncpg://payguard:payguard@localhost:5434/payguard
DATABASE_URL_SYNC=postgresql+psycopg2://payguard:payguard@localhost:5434/payguard
REDIS_URL=redis://localhost:6381/0
ENVIRONMENT=development
# Shared secret for verifying POST /v1/webhooks/provider signatures (dev-only
# placeholder -- generate a real random value for anything beyond local dev).
WEBHOOK_SECRET=dev_webhook_secret_change_me
# Merchant-scoped rate limiting (packages/ratelimit, docs/security.md).
# Optional -- defaults to 20 capacity / 5 tokens per second if unset.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=5
